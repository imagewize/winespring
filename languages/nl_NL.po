#. Theme Name of the theme
#: style.css inc/plugin-recommendations.php:102
msgid "Winespring"
msgstr "Winespring"

#. Theme URI of the theme
#: style.css
msgid "https://imagewize.com/themes/winespring"
msgstr "https://imagewize.com/themes/winespring"

#. Description of the theme
#: style.css
msgid ""
"Winespring is a lean full-site-editing theme for WooCommerce stores. It "
"ships a design system (theme.json), WooCommerce block templates, and style "
"variations and a small set of page patterns. Content is composed directly "
"from blocks. Built to speed up client e-commerce builds."
msgstr ""
"Winespring is een compact full-site-editing-thema voor WooCommerce-winkels. "
"Het bevat een ontwerpsysteem (theme.json), WooCommerce-bloksjablonen, "
"stijlvarianten en een kleine set paginapatronen. Inhoud wordt rechtstreeks "
"uit blokken samengesteld. Gebouwd om het bouwen van webwinkels voor klanten "
"te versnellen."

#. Author of the theme
#: style.css
msgid "Jasper Frumau"
msgstr "Jasper Frumau"

#. Author URI of the theme
#: style.css
msgid "https://imagewize.com"
msgstr "https://imagewize.com"

